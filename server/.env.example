# Read by `pnpm start` / `pnpm dev` (node --env-file-if-exists=.env) and
# checked at startup: an invalid value stops the server with the list of
# problems.

NODE_ENV=development
PORT=3300
# Listen only here (production: 127.0.0.1, so only nginx reaches the process).
# HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent (default: info; silent in tests)
# LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/aouerj
MONGODB_TIMEOUT_MS=5000
# Create the collections and indexes at startup (Mongoose's default). "false"
# only reads and writes documents: for checking a build against production.
MONGODB_AUTO_INDEX=true

# Request bodies. /aouerj keeps the old server's 100 KB: a 1.x error report
# carries the portal page, and a bigger limit would keep more of it.
JSON_LIMIT=100kb
GENERATOR_JSON_LIMIT=1mb
# How long the teacher name list stays cached in memory.
CACHE_TTL_MS=300000
# Writes (mural posts, error reports, suggestions) per IP per minute, together.
# Generous: the students on a campus share one IP.
RATE_LIMIT_PER_MINUTE=120
# Companhia agora: the token (or the member key) is each student's limit, so
# the IP only gets a loose ceiling against attacks (campus Wi-Fi and carrier
# CGNAT put hundreds of students behind one IP); the member key routes
# (phrases, leave, remove, reports from inside) count per key.
# COMPANION_IP_LIMIT_PER_MINUTE=1200
# COMPANION_MEMBER_LIMIT_PER_MINUTE=30

# Error report attachments. Defaults to server/AOreports.
# REPORTS_DIR=/home/ubuntu/server-pitroldev/AOreports

# GET /aouerj/reportError and GET /aouerj/suggestions list e-mails: they need
# "Authorization: Bearer <ADMIN_TOKEN>" (16+ characters) and do not exist
# while it is unset.
# ADMIN_TOKEN=

# Behind nginx: trust one hop, so the rate limit sees the student's IP.
# TRUST_PROXY=1
# Redirect plain HTTP to the public HTTPS origin (needs PUBLIC_URL).
FORCE_HTTPS=false
# PUBLIC_URL=https://pitrol.dev

# Aluno Online status check (GET /aouerj/portal-status); "off" disables it.
PORTAL_MONITOR=on
PORTAL_MONITOR_INTERVAL_MS=300000

# Schedule generator (POST /schedules/generate). Each search runs in its own
# worker thread: CONCURRENCY at once (the VM has 2 CPUs), QUEUE_LIMIT waiting
# (beyond that, 503), and a search returns the best it found after BUDGET_MS.
GENERATOR_CONCURRENCY=1
GENERATOR_QUEUE_LIMIT=32
GENERATOR_BUDGET_MS=10000
# Generations per IP per minute (the app may send up to 3 for one tap).
GENERATOR_RATE_LIMIT_PER_MINUTE=120

# API v2 (/aouerj/v2): anonymous student tokens (Privacy Pass, RFC 9577/9578,
# Blind RSA 2048). The issuer's keys, comma-separated, each as
# <DER in base64>@<YYYY-MM-DD> (the day it stops being valid). A private key
# (PKCS #8, plain RSA) redeems and issues; a public key (SPKI) only redeems,
# for an old key whose private part was discarded. Issuance signs with the
# private key that lasts longest. Without any key, the v2 answers 503.
# Generate an issuing key, and later its public-only entry, with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out issuer.pem
#   openssl pkcs8 -topk8 -nocrypt -in issuer.pem -outform DER | base64 -w0
#   openssl pkey -in issuer.pem -pubout -outform DER | base64 -w0
# PRIVATE_TOKEN_KEYS=
# The issuer and the origin in the token challenge (default: pitrol.dev).
# PRIVATE_TOKEN_ISSUER=pitrol.dev
# PRIVATE_TOKEN_ORIGIN=pitrol.dev

# Token issuance attests the app with Play Integrity (standard requests): the
# JSON key of a Google Cloud service account in the project linked to the
# app in the Play Console, with the Play Integrity API enabled. Without it,
# issuance answers 503 and redemption keeps working.
# PLAY_INTEGRITY_SERVICE_ACCOUNT=/home/ubuntu/ao-uerj-server/shared/play-integrity.json
# The SHA-256 fingerprints of the Play app signing certificate (Play Console,
# "App signing"), comma-separated, as AB:CD:… Required with the account.
# PLAY_INTEGRITY_CERT_SHA256=
# PLAY_INTEGRITY_PACKAGE=com.aouerjmobile
# "development" accepts any app (the emulator, debug builds); refused when
# NODE_ENV=production.
# TOKEN_ATTESTATION=play-integrity
# Tokens per batch, batches per installation per UTC day, and challenges plus
# batches per IP per minute.
# TOKEN_BATCH_SIZE=32
# TOKEN_BATCHES_PER_DAY=4
# TOKEN_RATE_LIMIT_PER_MINUTE=60

# Student identity (API v2): the app signs in with the matrícula of the Aluno
# Online login under the Play Integrity on Android (the same attestation
# settings above, plus the store install) or App Attest on the iPhone (below).
# The matrícula and the name are encrypted with keys derived from
# STUDENT_DATA_KEY: 32 bytes in base64 (openssl rand -base64 32). Without it,
# sign-in answers 503. Changing it loses the stored students.
# STUDENT_DATA_KEY=
# iPhone sign-in: the App ID of the app, <Team ID>.<bundle id>, from the Apple
# Developer account. The server checks each App Attest attestation itself,
# against the Apple App Attestation Root CA pinned in the code, without calling
# Apple. Unset, iPhone sign-in answers 503 and Android is not affected.
# APPLE_APP_ATTEST_APP_ID=ABCDE12345.com.aouerjmobile
# "production" (App Store and TestFlight builds); "development" also accepts
# the keys of builds run from Xcode (the development App Attest environment).
# APPLE_APP_ATTEST_ENVIRONMENT=production
# The anonymous tokens of the apps 2.11.1 to 2.13 in the Companhia routes:
# "accept" while they are around, "refuse" to require the student session.
# STUDENT_TOKENS=accept
# Challenges, sign-ins and sign-outs per IP per minute. Each sign-in is a
# challenge plus a request, and an Android one spends one Play Integrity decode
# from the Google quota; a student signs in about once a month, so the campus
# Wi-Fi fits.
# STUDENT_RATE_LIMIT_PER_MINUTE=120
# Requests per student per minute once the server already knows the session (it
# stays cached for 5 minutes): they no longer share the per-IP ceiling above
# with the rest of the campus Wi-Fi. Unknown sessions still count per IP.
# STUDENT_SESSION_LIMIT_PER_MINUTE=300
