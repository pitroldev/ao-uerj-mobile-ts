{
  "name": "@ao-uerj/server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend próprio do AO UERJ: mural, docentes, relatos de erro, sugestões, a situação do Aluno Online e o gerador de grades.",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "mongodb-memory-server-core": "^11.3.0"
  }
}
