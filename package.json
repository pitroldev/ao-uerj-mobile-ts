{
  "name": "aouerjmobile",
  "version": "2.9.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/gradle.cjs clean",
    "build": "node scripts/gradle.cjs assembleRelease",
    "build:debug": "node scripts/gradle.cjs assembleDebug",
    "bundle": "node scripts/gradle.cjs bundleRelease",
    "android": "react-native run-android",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:ci": "jest --runInBand --ci",
    "test:tooling": "node --test scripts/__tests__/*.test.cjs",
    "e2e": "maestro test .maestro",
    "diagnose:ao": "node scripts/diagnose-ao.cjs",
    "diagnose:documents": "node scripts/diagnose-documents.cjs",
    "lint": "oxlint --type-aware --deny-warnings",
    "knip": "knip"
  },
  "dependencies": {
    "@preeternal/react-native-cookie-manager": "^7.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/drawer": "^7.14.4",
    "@react-navigation/native": "^7.5.1",
    "@sentry/react-native": "^8.31.0",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "parse5": "^7.3.0",
    "parse5-htmlparser2-tree-adapter": "^7.1.0",
    "react": "19.2.3",
    "react-hook-form": "^7.90.0",
    "react-native": "0.87.1",
    "react-native-bootsplash": "^7.3.4",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-hyperlink": "^0.1.2",
    "react-native-in-app-review": "^4.4.2",
    "react-native-keyboard-controller": "^1.22.7",
    "react-native-keychain": "10.0.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-screens": "^4.30.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.16.0",
    "react-native-toast-message": "^2.5.2",
    "react-native-view-shot": "^6.1.1",
    "react-native-worklets": "0.13.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/runtime": "^7.29.10",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@styled/typescript-styled-plugin": "^1.1.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-jest": "^30.5.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.2",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.10",
    "test-renderer": "~1.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "codegenConfig": {
    "name": "AppSpecs",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.aouerjmobile.specs"
    },
    "ios": {
      "modulesProvider": {
        "AppNotifications": "AppNotificationsModule",
        "HomeWidget": "HomeWidgetModule",
        "SecureVault": "SecureVaultModule"
      }
    }
  },
  "packageManager": "pnpm@12.11.2"
}
