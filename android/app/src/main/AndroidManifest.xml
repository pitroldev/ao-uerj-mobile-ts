<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <uses-permission android:name="android.permission.INTERNET" />
  <!-- Avisos (lembretes de aula e verificação no portal), pedida ao ligar um aviso. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Lembrete no minuto certo; sem ela, o Android entrega numa janela de 10 minutos. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
  <!-- Refaz os lembretes depois de reiniciar o aparelho. -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application
    android:name=".MainApplication"
    android:label="@string/app_name"
    android:icon="@mipmap/ic_launcher"
    android:roundIcon="@mipmap/ic_launcher_round"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:networkSecurityConfig="@xml/network_security_config"
    android:theme="@style/AppTheme"
    android:supportsRtl="true">
    <!--
      O react-native-share declara o próprio provider com esta mesma authority e
      caminhos mais amplos (Download/ do armazenamento externo). Só um provider por
      authority é registrado; o dele sai para que valha sempre o @xml/filepaths.
    -->
    <provider
      android:name="cl.json.RNShareFileProvider"
      android:authorities="${applicationId}.rnshare.fileprovider"
      tools:node="remove" />
    <provider
      android:name="androidx.core.content.FileProvider"
      android:authorities="${applicationId}.rnshare.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/filepaths" />
    </provider>
    <activity
      android:name=".MainActivity"
      android:label="@string/app_name"
      android:screenOrientation="portrait"
      android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
      android:launchMode="singleTask"
      android:windowSoftInputMode="adjustResize"
      android:theme="@style/BootTheme"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
      <!-- Atalhos do ícone: Próxima aula, Notas, Mapa e Documentos (abrem pela ShortcutActivity). -->
      <meta-data
        android:name="android.app.shortcuts"
        android:resource="@xml/shortcuts" />
    </activity>
    <!-- Trampolim dos atalhos do ícone, sem tela. O Android abre atalhos estáticos limpando a
         tarefa (FLAG_ACTIVITY_CLEAR_TASK): numa tarefa própria (taskAffinity vazio), só ela é
         limpa, e a MainActivity recebe o destino como no toque do aviso e do widget, sem recriar o
         app aberto. Não exportada: a launcher abre o atalho em nome do app
         (LauncherApps.startShortcut). Sem screenOrientation: activity translúcida não pode fixar
         a orientação no Android 8.0. -->
    <activity
      android:name=".ShortcutActivity"
      android:excludeFromRecents="true"
      android:exported="false"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    <!-- Lembretes de aula (AlarmManager). Não exportados: só o sistema os chama. -->
    <receiver
      android:name=".notifications.ClassReminderReceiver"
      android:exported="false" />
    <receiver
      android:name=".notifications.RescheduleReceiver"
      android:exported="false">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>
    <!-- Widget "Próxima aula". As ações de relógio, boot e atualização refazem o desenho e o
         alarme da próxima virada de aula. -->
    <receiver
      android:name=".widget.NextClassWidget"
      android:exported="false"
      android:label="@string/widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.DATE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_next_class_info" />
    </receiver>
    <!-- Widget "Hoje" (TodayWidget.kt): as aulas do dia, com os mesmos dados e alarmes do
         "Próxima aula". -->
    <receiver
      android:name=".widget.TodayWidget"
      android:exported="false"
      android:label="@string/widget_today_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <action android:name="android.intent.action.TIME_SET" />
        <action android:name="android.intent.action.TIMEZONE_CHANGED" />
        <action android:name="android.intent.action.DATE_CHANGED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/widget_today_info" />
    </receiver>
  </application>
</manifest>