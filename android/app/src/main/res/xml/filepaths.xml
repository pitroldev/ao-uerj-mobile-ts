<?xml version="1.0" encoding="utf-8"?>
<!--
  A grade e os documentos são compartilhados a partir do cache: o view-shot
  grava o PNG no cache interno ou externo, o fallback SVG usa o cache externo,
  e os PDFs oficiais usam exclusivamente <cache interno>/Download.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <cache-path name="cache" path="." />
  <external-cache-path name="external_cache" path="." />
</paths>
